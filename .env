# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=sua-chave-secreta-super-segura-aqui
SECURITY_TOKEN=sua-chave-jwt-super-segura-aqui
SECURITY_EMISSOR=graacc-api-django

# Database Configuration (PostgreSQL)
DATABASE_NAME=graacc_db
DATABASE_USER=graacc_user
DATABASE_PASSWORD=graacc_password
DATABASE_HOST=postgres
DATABASE_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# Server Configuration
SERVER_PORT=8000

# WhatsApp API
WHATSAPP_API_BASE_URL=https://api.whatsapp.api-zap.com.br/api
WHATSAPP_API_TOKEN=seu_token_da_sessao_aqui
WHATSAPP_API_ENDPOINT=/message/text

# Cron Configuration
REMINDER_CRON_SCHEDULE=0 8 * * *
